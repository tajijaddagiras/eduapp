      "adaptiveIcon": {
        "backgroundColor": "#eff5f1",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.girasss.eduapp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "f15e4841-4e3f-4c60-bab3-df1342b748cf"
      }
    },
    "owner": "appsedus-team"
